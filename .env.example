# Application
APP_NAME=Resume Screening Service
DEBUG=true

# Shared secret required on every /api/v1/* request (X-API-Key header).
# Fails closed if left blank - see "Authentication" in README.md.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/resume_screening

# Ollama (local LLM + embeddings)
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=768

# Pinecone
# Create a key at https://app.pinecone.io/ and put the real value in .env only.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=resume-screening-nomic-768
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Screening defaults
VECTOR_TOP_K=20
RANKING_TOP_N=5

# Event-driven ingestion worker (app/worker.py) — only needed to run the SQS consumer
AWS_REGION=us-east-1
SQS_QUEUE_URL=
S3_BUCKET_NAME=
DYNAMODB_TABLE_NAME=resume-processing-status
WORKER_METRICS_PORT=9100
