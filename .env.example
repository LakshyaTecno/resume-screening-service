# Application
APP_NAME=Resume Screening Service
DEBUG=true

# Per-tenant API keys live in the api_keys table, not here - see
# "Authentication and multi-tenancy" in README.md.

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/resume_screening

# Ollama (local LLM + embeddings)
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=768

# Pinecone
# Create a key at https://app.pinecone.io/ and put the real value in .env only.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=resume-screening-nomic-768
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Screening defaults
VECTOR_TOP_K=20
RANKING_TOP_N=5

# Event-driven ingestion worker (app/worker.py) — only needed to run the SQS consumer
AWS_REGION=us-east-1
SQS_QUEUE_URL=
S3_BUCKET_NAME=
DYNAMODB_TABLE_NAME=resume-processing-status
WORKER_METRICS_PORT=9100

# Razorpay billing — from your Razorpay dashboard (Settings > API Keys,
# Settings > Webhooks for the webhook secret)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin API (/api/v1/admin/*) — HTTP Basic, a single operator credential.
# Fails closed if left blank - see "Admin API" in README.md.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Self-service tenant auth (/api/v1/auth/*) — sits alongside per-tenant
# API keys, not instead of them. JWT_SECRET fails closed if left blank,
# same as ADMIN_USERNAME/ADMIN_PASSWORD above - generate a real one with
# `openssl rand -hex 32`. GOOGLE_OAUTH_CLIENT_ID is only needed for
# POST /auth/google - from console.cloud.google.com's OAuth client config.
JWT_SECRET=
JWT_EXPIRY_MINUTES=1440
GOOGLE_OAUTH_CLIENT_ID=

# Lifetime cap for a tenant with no active subscription - see "Billing"
# in README.md.
FREE_TIER_RESUME_LIMIT=20
