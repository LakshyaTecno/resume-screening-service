# Copy to .env.local (gitignored by create-next-app's default .gitignore).

# Where the FastAPI backend is reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional. Leave blank and the Google sign-in button simply doesn't
# render - email/password auth works fully without it. Must match the
# backend's own GOOGLE_OAUTH_CLIENT_ID (see ../.env.example) - they're
# the same Google Cloud OAuth client, used on both sides.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
